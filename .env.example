GEMINI_API_KEY=
GEMINI_API_KEY_2=
# optional, comma-separated, tried in order (max 3): GEMINI_MODELS_QUICK, GEMINI_MODELS_REVIEW
# Required for real AI conversations. Without it the app runs in demo mode with canned replies.
ANTHROPIC_API_KEY=

# Optional model overrides
AI_MODEL_QUICK=claude-haiku-5-5
AI_MODEL_DEFAULT=claude-sonnet-5-5

# Optional: max AI requests per IP per minute (default 30)
AI_RATE_LIMIT=30
